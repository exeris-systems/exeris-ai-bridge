<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.exeris</groupId>
        <artifactId>exeris-app-bom</artifactId>
        <version>0.10.0</version>
        <relativePath>../exeris-app-bom/pom.xml</relativePath>
    </parent>

    <artifactId>exeris-app-starter</artifactId>
    <packaging>pom</packaging>

    <name>Exeris Tooling :: Application Starter</name>
    <description>
        The dependencies an application generated by exeris-tooling compiles and runs against.
        Declare it with type pom.
    </description>
    <url>https://github.com/exeris-systems/exeris-tooling</url>

    <!--
        Every artefact the generated sources import, at the scope they need it (ADR-091
        obligation 3). The invoker fixture in exeris-app-starter-it compiles a generated
        application against this set plus the application's own JDBC driver and test libraries, so
        an emitter that starts importing anything else fails the reactor build.

        Not here, on purpose:
        - a JDBC driver: the database is the application's choice;
        - a logging backend: generated code logs through System.Logger and binds no facade;
        - JUnit 5 and AssertJ: the generated tests' contract, declared in the application's own
          test scope.
    -->
    <dependencies>
        <!-- Compile scope, not provided: Maven does not pass a dependency's provided-scope
             dependencies on, so at provided the application would never see the annotations. They
             are @Retention(SOURCE), so the jar that reaches the runtime classpath is inert. -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-sdk-annotations</artifactId>
        </dependency>

        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-core</artifactId>
        </dependency>

        <!-- The default runtime driver: every subsystem provider arrives from it through
             ServiceLoader. An application on another driver excludes this one and declares its
             own; exeris:verify-runtime checks for registered providers, not for this artefact. -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-community</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Compile scope, because emitted MAIN code imports both: the composed Application imports
             CompositionConductor when there is a @CapabilityModule, and the repository of an entity
             with a List<X> field imports tools.jackson. -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-sdk-composition-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>
</project>
