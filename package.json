{
  "name": "@exeris/ai-bridge",
  "version": "0.6.0",
  "description": "Model Context Protocol server exposing Exeris ecosystem surfaces (Studio/LSP, docs/ADR registry, kernel introspection) to AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/server.js",
  "bin": {
    "exeris-ai-bridge": "dist/server.js"
  },
  "files": [
    "dist",
    "data",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/*.spec.js",
    "!dist/**/*.spec.d.ts",
    "!dist/**/*.spec.js.map",
    "!dist/**/*.spec.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/__mocks__/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist data",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "npm run build",
    "test": "cd dist && node --test",
    "test:coverage": "c8 --reporter=lcovonly --reporter=text-summary --report-dir=coverage --exclude='**/*.test.*' npm test",
    "smoke:p2": "npm run build && node scripts/p2-smoke.mjs",
    "vendor:data": "node scripts/vendor-reference-data.mjs --emit",
    "prepack": "node scripts/vendor-reference-data.mjs --emit --verify"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "c8": "^12.0.0",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exeris-systems/exeris-ai-bridge.git"
  },
  "keywords": [
    "exeris",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "lsp"
  ]
}
