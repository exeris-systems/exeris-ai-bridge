node_modules/
dist/
*.log
*.tsbuildinfo

# Environment files — never commit secrets. Keep .env.example tracked.
.env
.env.*
!.env.example

# OS noise
.DS_Store

# Editor noise
.idea/
.vscode/
!.vscode/extensions.json
*.swp

# Per-user Claude Code settings — shared agents/commands/skills stay tracked
.claude/settings.local.json

# Local planning scratch — never committed
*.local.md

# Generated at pack time by scripts/vendor-reference-data.mjs — never committed.
# Leading slash anchors this to the repo root: an unanchored `data/` would also
# swallow src/data/, which is source and must be committed.
/data/
